# KaamConnect Environment Variables Template
# Copy this file to .env and provide your actual Supabase project keys

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for frontend browsers)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# App Environment
VITE_APP_ENV=development
